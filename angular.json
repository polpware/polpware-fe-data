{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "polpware-fe-data-host": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "css"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",        
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "outputPath": "dist/polpware-fe-data-host",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "tsConfig": "src/tsconfig.app.json",
                        "polyfills": "src/polyfills.ts",
                        "assets": [
                            "src/assets",
                            "src/favicon.ico"
                        ],
                        "styles": [
                            "src/styles.css"
                        ],
                        "scripts": [],
                        "vendorChunk": true,
                        "extractLicenses": false,
                        "buildOptimizer": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true
                    },
                    "configurations": {
                        "production": {
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "fileReplacements": [
                                {
                                "replace": "src/environments/environment.ts",
                                "with": "src/environments/environment.prod.ts"
                            }
                            ],
                            "budgets": [
                                {
                                "type": "initial",
                                "maximumWarning": "2mb",
                                "maximumError": "5mb"
                            },
                                {
                                "type": "anyComponentStyle",
                                "maximumWarning": "6kb"
                            }
                            ]
                        },
                        "development": {}
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                    },
                    "configurations": {
                        "production": {
                          "buildTarget": "polpware-fe-data-host:build:production"
                        },
                        "development": {
                          "buildTarget": "polpware-fe-data-host:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                      "buildTarget": "polpware-fe-data-host:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "karmaConfig": "src/karma.conf.js",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "src/tsconfig.spec.json",
                        "scripts": [],
                        "styles": [
                            "src/styles.css"
                        ],
                        "assets": [
                            "src/assets",
                            "src/favicon.ico"
                        ]
                    }
                }
            }
        },
        "polpware-fe-data-host-e2e": {
            "root": "e2e/",
            "projectType": "application",
            "prefix": "",
            "architect": {
                "e2e": {
                    "builder": "@angular-devkit/build-angular:protractor",
                    "options": {
                        "protractorConfig": "e2e/protractor.conf.js"
                    },
                    "configurations": {
                        "production": {
                            "devServerTarget": "polpware-fe-data-host:serve:production"
                        },
                        "development": {
                            "devServerTarget": "polpware-fe-data-host:serve:development"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            }
        },
        "@polpware/fe-data": {
            "projectType": "library",            
            "root": "projects/polpware/fe-data",
            "sourceRoot": "projects/polpware/fe-data/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/polpware/fe-data/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/polpware/fe-data/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/polpware/fe-data/tsconfig.lib.json"                            
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "projects/polpware/fe-data/src/test.ts",
                        "tsConfig": "projects/polpware/fe-data/tsconfig.spec.json",
                        "karmaConfig": "projects/polpware/fe-data/karma.conf.js"
                    }
                }
            }
        }
    },
    "cli": {
      "analytics": "e9b5f521-e00c-4f78-afc3-70ef983daa76"
    }
}
